# Ça Parle — .env
# Reprend le MÊME projet et la MÊME base de données que Kinema+
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=          # même projectId que Kinema+
VITE_APPWRITE_DATABASE_ID=         # même databaseId que Kinema+

# Collection partagée avec Kinema+
VITE_APPWRITE_COLLECTION_USERS=

# Nouvelles collections Ça Parle (IDs que tu as créés dans la console)
VITE_APPWRITE_COLLECTION_STORIES=
VITE_APPWRITE_COLLECTION_STORY_UPDATES=
VITE_APPWRITE_COLLECTION_COMMENTS=
VITE_APPWRITE_COLLECTION_REACTIONS=
VITE_APPWRITE_COLLECTION_PREDICTIONS=
VITE_APPWRITE_COLLECTION_PREDICTION_VOTES=
VITE_APPWRITE_COLLECTION_STORY_VERSIONS=
VITE_APPWRITE_COLLECTION_VERSION_VOTES=
VITE_APPWRITE_COLLECTION_REFERENCES=
VITE_APPWRITE_COLLECTION_STORY_REFERENCES=
VITE_APPWRITE_COLLECTION_FOLLOWS=
VITE_APPWRITE_COLLECTION_NOTIFICATIONS=
VITE_APPWRITE_COLLECTION_REPORTS=
VITE_APPWRITE_COLLECTION_BADGES=
VITE_APPWRITE_COLLECTION_USER_BADGES=
VITE_APPWRITE_COLLECTION_CATEGORIES=
VITE_APPWRITE_FUNCTION_START_CONVERSATION=
VITE_APPWRITE_FUNCTION_SEND_MESSAGE=
VITE_APPWRITE_FUNCTION_SEND_NEWSLETTER=
VITE_APPWRITE_FUNCTION_UNSUBSCRIBE_NEWSLETTER=